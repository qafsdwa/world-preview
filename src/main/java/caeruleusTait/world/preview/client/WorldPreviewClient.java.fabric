package caeruleusTait.world.preview.client;

import com.mojang.blaze3d.platform.NativeImage;
import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.api.EnvType;
import net.fabricmc.api.Environment;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.renderer.texture.DynamicTexture;
import org.apache.commons.lang3.StringUtils;

import java.util.Arrays;
import java.util.stream.Collectors;

@Environment(EnvType.CLIENT)
public class WorldPreviewClient implements ClientModInitializer {

    @Override
    public void onInitializeClient() {
        // Nothing to do -- all hooks are mixins
    }

    public static void renderTexture(GuiGraphicsExtractor graphics, DynamicTexture texture, int x0, int y0, int x1, int y1) {
        graphics.blit(texture.getTextureView(), texture.getSampler(), x0, y0, x1, y1, 0.0F, 1.0F, 0.0F, 1.0F);
    }

    public static DynamicTexture createDynamicTexture(String label, NativeImage image) {
        return new DynamicTexture(() -> label, image);
    }

    public static String toTitleCase(String input) {
        if (input == null || input.isBlank()) {
            return input;
        }

        return Arrays
                .stream(input.split(" "))
                .map(StringUtils::capitalize)
                .collect(Collectors.joining(" "));
    }
}
